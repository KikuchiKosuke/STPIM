<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,stpim.model.Block,stpim.model.BlockStatus,stpim.model.BlockType,stpim.model.Priority,stpim.model.BetterDirection,stpim.service.BlockInput,stpim.util.Html" %>
<%
Block block = (Block) request.getAttribute("block");
BlockInput form = (BlockInput) request.getAttribute("form");
boolean locked = block != null && (block.getStatus() == BlockStatus.DONE || block.getActualStartAt() != null);
@SuppressWarnings("unchecked") List<Block> seriesCandidates = (List<Block>) request.getAttribute("seriesCandidates");
@SuppressWarnings("unchecked") List<String> errors = (List<String>) request.getAttribute("errors");
String date = String.valueOf(request.getAttribute("date"));
String type = form != null && form.blockType != null ? form.blockType.name() : block != null ? block.getBlockType().name() : "";
String title = form != null ? form.title : block != null ? block.getTitle() : "";
String memo = form != null ? form.memo : block != null ? block.getMemo() : "";
String start = form != null && form.plannedStartTime != null ? form.plannedStartTime.toString() : block != null && block.getPlannedStartTime()!=null ? block.getPlannedStartTime().toString() : "09:00";
String end = form != null && form.plannedEndTime != null ? form.plannedEndTime.toString() : block != null && block.getPlannedEndTime()!=null ? block.getPlannedEndTime().toString() : "10:00";
int rank = form != null && form.priority != null ? form.priority.getRank() : block != null && block.getPriority()!=null ? block.getPriority().getRank() : 2;
boolean attack = form != null ? form.timeAttack : block != null && block.isTimeAttack();
String direction = form != null && form.betterDirection != null ? form.betterDirection.name() : block != null && block.getBetterDirection()!=null ? block.getBetterDirection().name() : "";
String compareId = request.getParameter("compareBlockId");
String ctx = request.getContextPath();
if (compareId == null && block != null && block.getSeriesId()!=null) for(Block candidate:seriesCandidates) if(candidate.getSeriesId().equals(block.getSeriesId())) { compareId=String.valueOf(candidate.getId()); break; }
%>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= block==null ? "ブロックを追加" : "ブロックを編集" %> | STPIM</title><link rel="stylesheet" href="<%= ctx %>/css/style.css"></head><body><div class="app-shell">
<%@ include file="header.jspf" %>
<main class="page"><div class="page-heading"><div><p class="eyebrow">予定をひとつ、ブロックに</p><h1><%= block==null ? "ブロックを追加" : "ブロックを編集" %></h1><p class="heading-sub">時間制か優先順位を選んで、今日の積み上げに。</p></div><a class="button" href="<%= ctx %>/day?date=<%= date %>">日画面へ戻る</a></div>
<div class="form-layout"><section class="panel form-panel"><% if(locked){ %><div class="soft-note" style="margin-bottom:18px">開始済み・完了済みのため、記録に関わる設定は変更できません。タイトルとメモを編集できます。</div><% } %>
<% if(errors!=null && !errors.isEmpty()){ %><div class="auth-error" role="alert"><% for(String error:errors){ %><div><%= Html.escape(error) %></div><% } %></div><% } %>
<form id="block-form" method="post" action="<%= ctx %>/blocks/save"><% if(block!=null){ %><input type="hidden" name="id" value="<%= block.getId() %>"><% } %>
<label class="field"><span class="field-label">タイトル <strong style="color:var(--red)">必須</strong></span><input name="title" maxlength="100" required value="<%= Html.escape(title) %>" placeholder="例：プロジェクト会議"></label>
<label class="field"><span class="field-label">メモ <span class="tiny">任意</span></span><textarea name="memo" maxlength="500" placeholder="内容や持ち物など"><%= Html.escape(memo) %></textarea></label>
<label class="field"><span class="field-label">積み方 <strong style="color:var(--red)">必須</strong></span><select class="select-inline" id="block-type" name="blockType" required <%= locked ? "disabled" : "" %>><option value="">選択してください</option><option value="TIME" <%= "TIME".equals(type) ? "selected" : "" %>>時間制</option><option value="PRIORITY" <%= "PRIORITY".equals(type) ? "selected" : "" %>>優先順位</option></select></label>
<label class="field"><span class="field-label">日付</span><input type="date" name="targetDate" value="<%= date %>" required <%= locked ? "disabled" : "" %>></label>
<section class="time-fields" id="time-fields"><div class="subsection-label"><span class="type-chip">時間制の予定</span><span class="tiny">開始から終了までを予定時間にします</span></div><div class="two-fields"><label class="field"><span class="field-label">開始時刻</span><input type="time" name="plannedStartTime" value="<%= start %>" <%= locked ? "disabled" : "" %>></label><label class="field"><span class="field-label">終了時刻</span><input type="time" name="plannedEndTime" value="<%= end %>" <%= locked ? "disabled" : "" %>></label></div></section>
<section class="priority-fields" id="priority-fields"><div class="subsection-label"><span class="type-chip priority">優先順位の用事</span><span class="tiny">上ほど優先して取り組む</span></div><label class="field"><span class="field-label">優先順位</span><select class="select-inline" name="priority" <%= locked ? "disabled" : "" %>><option value="1" <%= rank==1 ? "selected" : "" %>>高</option><option value="2" <%= rank==2 ? "selected" : "" %>>中</option><option value="3" <%= rank==3 ? "selected" : "" %>>低</option></select></label></section>
<section class="attack-fields"><label class="check-row"><input type="checkbox" name="timeAttack" id="time-attack" <%= attack ? "checked" : "" %> <%= locked ? "disabled" : "" %>><span>タイムアタックにする</span><span class="type-chip attack">記録を比べる</span></label><div id="attack-options"><% if(seriesCandidates!=null && !seriesCandidates.isEmpty()){ %><label class="field"><span class="field-label">比べる過去のブロック</span><select class="select-inline" name="compareBlockId" id="compare-block" <%= locked ? "disabled" : "" %>><option value="">新しく記録を始める</option><% for(Block candidate:seriesCandidates){ %><option value="<%= candidate.getId() %>" data-direction="<%= candidate.getBetterDirection() %>" <%= String.valueOf(candidate.getId()).equals(compareId) ? "selected" : "" %>><%= Html.escape(candidate.getTitle()) %>（<%= candidate.getActualEndAt().toLocalDate() %> ／ <%= candidate.getBetterDirection()==BetterDirection.LONGER ? "長い方" : "短い方" %>）</option><% } %></select></label><% } else { %><p class="tiny">比較できる過去の記録はまだありません。ここから記録を始めます。</p><% } %>
<div class="field"><span class="field-label">どちらが良い記録？</span><div class="radio-row"><label class="radio-card"><input type="radio" name="betterDirection" value="LONGER" <%= "LONGER".equals(direction) ? "checked" : "" %> <%= locked ? "disabled" : "" %>>長い方が良い</label><label class="radio-card"><input type="radio" name="betterDirection" value="SHORTER" <%= "SHORTER".equals(direction) ? "checked" : "" %> <%= locked ? "disabled" : "" %>>短い方が良い</label></div></div></div></section>
<footer class="modal-footer"><a class="button" href="<%= ctx %>/day?date=<%= date %>">キャンセル</a><span class="spacer"></span><button class="button primary" type="submit">保存する</button></footer></form>
<% if(block!=null){ %><form method="post" action="<%= ctx %>/blocks/delete" onsubmit="return confirm('このブロックと記録を削除しますか？');"><input type="hidden" name="id" value="<%= block.getId() %>"><button class="button danger small" type="submit">このブロックを削除</button></form><% } %>
</section><aside class="panel side-card"><h2>ブロックの作り方</h2><p class="tiny" style="line-height:1.8">時間制は時刻どおりに進めたい予定、優先順位は順不同の用事に向いています。タイムアタックは同じシリーズの所要時間を記録します。</p><div class="soft-note">終了時刻は開始時刻より後に設定してください。優先順位ブロックの所要時間は、開始ボタンを押した場合だけ計算します。</div></aside></div></main></div>
<script>(function(){var t=document.getElementById('block-type'),time=document.getElementById('time-fields'),priority=document.getElementById('priority-fields'),attack=document.getElementById('time-attack'),options=document.getElementById('attack-options'),compare=document.getElementById('compare-block');function show(){time.style.display=t.value==='TIME'?'block':'none';priority.style.display=t.value==='PRIORITY'?'block':'none';options.style.display=attack.checked?'block':'none';}function sync(){if(!compare)return;var selected=compare.options[compare.selectedIndex],direction=selected&&selected.dataset.direction;if(direction){document.querySelectorAll('input[name=betterDirection]').forEach(function(r){r.checked=r.value===direction;r.disabled=true;});}else document.querySelectorAll('input[name=betterDirection]').forEach(function(r){r.disabled=false;});}t.addEventListener('change',show);attack.addEventListener('change',show);if(compare)compare.addEventListener('change',sync);show();sync();})();</script>
</body></html>
