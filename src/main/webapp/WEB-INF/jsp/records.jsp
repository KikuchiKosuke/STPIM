<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,stpim.model.Block,stpim.model.BlockType,stpim.model.BlockStatus,stpim.util.Html" %>
<%
@SuppressWarnings("unchecked") List<Block> blocks=(List<Block>)request.getAttribute("blocks");
@SuppressWarnings("unchecked") List<String> months=(List<String>)request.getAttribute("months");
String selectedStatus=(String)request.getAttribute("selectedStatus"), selectedMonth=(String)request.getAttribute("selectedMonth");
String ctx=request.getContextPath();
%>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>記録・累計 | STPIM</title><link rel="stylesheet" href="<%= ctx %>/css/style.css"></head><body><div class="app-shell">
<%@ include file="header.jspf" %>
<main class="page"><div class="page-heading"><div><p class="eyebrow">今日までの積み上げ</p><h1>記録・累計</h1><p class="heading-sub">クリアした数も、残っている予定も。</p></div><div class="heading-actions"><a class="button" href="<%= ctx %>/time-attack">タイムアタックを見る　→</a></div></div>
<div class="summary-cards"><section class="panel summary-card emphasis"><span class="stat-label">累計クリア数</span><div class="stat-value"><%= request.getAttribute("totalCleared") %></div></section><section class="panel summary-card"><span class="stat-label">未着手</span><div class="stat-value"><%= request.getAttribute("todoCount") %></div></section><section class="panel summary-card"><span class="stat-label">未処理（記録に残す）</span><div class="stat-value"><%= request.getAttribute("missedCount") %></div></section></div>
<section class="panel records-table-panel"><div class="filter-bar"><h2 style="font-size:14px;margin:0">ブロックの記録</h2><div class="filter-pills"><% for(String state:new String[]{"ALL","TODO","DONE","MISSED"}){String label="ALL".equals(state)?"すべて":"TODO".equals(state)?"未着手":"DONE".equals(state)?"完了":"未処理"; %><a class="filter-button <%= state.equals(selectedStatus) ? "active" : "" %>" href="?status=<%= state %>&month=<%= selectedMonth %>"><%= label %></a><% } %></div><select class="select-compact" id="record-month" onchange="location.href='?status=<%= selectedStatus %>&month='+encodeURIComponent(this.value)"><option value="ALL" <%= "ALL".equals(selectedMonth)?"selected":"" %>>期間：すべて</option><% for(String m:months){ %><option value="<%= m %>" <%= m.equals(selectedMonth)?"selected":"" %>><%= m.replace("-","年") %>月</option><% } %></select></div>
<div class="table-wrap"><table class="records-table"><thead><tr><th>日付</th><th>ブロック</th><th>積み方</th><th>状態</th><th>予定</th><th>実績</th><th>差</th></tr></thead><tbody><% if(blocks.isEmpty()){ %><tr><td colspan="7"><div class="no-data">条件に合うブロックがありません</div></td></tr><% } for(Block b:blocks){ %>
<tr><td class="mono"><%= b.getTargetDate().toString().substring(5).replace("-","/") %></td><td class="row-title"><a href="<%= ctx %>/day?date=<%= b.getTargetDate() %>&tab=<%= b.getBlockType() %>"><%= Html.escape(b.getTitle()) %></a></td><td><span class="type-chip <%= b.getBlockType()==BlockType.PRIORITY?"priority":"" %> <%= b.isTimeAttack()?"attack":"" %>"><%= b.isTimeAttack()?"タイムアタック":b.getBlockType()==BlockType.TIME?"時間制":"優先順位" %></span></td><td><span class="status-pill <%= b.getStatus().name().toLowerCase() %>"><%= b.getStatus()==BlockStatus.TODO?"未着手":b.getStatus()==BlockStatus.DONE?"完了":"未処理" %></span></td><td class="mono"><%= b.getBlockType()==BlockType.TIME?b.getPlannedStartTime()+"〜"+b.getPlannedEndTime():"—" %></td><td class="mono"><%= b.getActualEndAt()==null?"—":(b.getActualStartAt()==null?"":b.getActualStartAt().toLocalTime()+"〜")+b.getActualEndAt().toLocalTime()+(b.isManualEnd()?" 手入力":" クリア") %></td><td class="mono"><% if(b.getStatus()==BlockStatus.DONE && b.getBlockType()==BlockType.TIME){long diff=java.time.Duration.between(b.getTargetDate().atTime(b.getPlannedEndTime()),b.getActualEndAt()).getSeconds();int minutes=(int)Math.round(diff/60.0); %><%= minutes>0?"+":"" %><%= minutes %>分<% } else { %>—<% } %></td></tr>
<% } %></tbody></table></div><div class="soft-note" style="margin-top:14px">予定との差は実績終了 − 予定終了で表示します。遅れは＋、早まりは−です。</div></section></main></div></body></html>
