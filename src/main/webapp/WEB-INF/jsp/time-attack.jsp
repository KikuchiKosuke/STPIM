<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,stpim.model.Block,stpim.model.BetterDirection,stpim.util.Html,stpim.servlet.TimeAttackServlet" %>
<%
@SuppressWarnings("unchecked") List<Block> series=(List<Block>)request.getAttribute("series");
@SuppressWarnings("unchecked") List<Block> records=(List<Block>)request.getAttribute("records");
@SuppressWarnings("unchecked") java.util.Map<Integer,Integer> bestBySeries=(java.util.Map<Integer,Integer>)request.getAttribute("bestBySeries");
Block active=(Block)request.getAttribute("active"); Integer best=(Integer)request.getAttribute("best");
String ctx=request.getContextPath();
%>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>タイムアタック | STPIM</title><link rel="stylesheet" href="<%= ctx %>/css/style.css"></head><body><div class="app-shell">
<%@ include file="header.jspf" %>
<main class="page"><div class="page-heading"><div><p class="eyebrow">昨日の自分と比べる</p><h1>タイムアタック</h1><p class="heading-sub">同じ系列の記録を振り返ります。</p></div></div>
<% if(series.isEmpty()){ %><section class="panel no-data">タイムアタックのブロックはまだありません。<div style="margin-top:14px"><a class="button primary" href="<%= ctx %>/blocks/new?date=<%= stpim.util.Clock.today() %>">ブロックを作る</a></div></section><% } else { %>
<div class="records-layout"><aside class="panel series-list"><h2>タイムアタックの一覧</h2><% for(Block s:series){ Integer seriesBest=bestBySeries.get(s.getSeriesId()); %><a class="series-option <%= active!=null&&s.getSeriesId().equals(active.getSeriesId())?"active":"" %>" href="?series=<%= s.getSeriesId() %>"><span class="series-name"><%= Html.escape(s.getTitle()) %></span><span class="series-meta"><%= s.getBetterDirection()==BetterDirection.LONGER?"長い方が良い":"短い方が良い" %> ／ 自己ベスト <%= seriesBest==null?"—":seriesBest+"分" %></span></a><% } %><p class="tiny">比較対象を選ぶと系列がつながります。タイトルの一致では記録をまとめません。</p></aside>
<section class="panel records-main"><div class="records-title-row"><h2><%= Html.escape(active.getTitle()) %></h2><span class="type-chip attack"><%= active.getBetterDirection()==BetterDirection.LONGER?"長い方が良い":"短い方が良い" %></span><span class="spacer"></span><a class="button small" href="<%= ctx %>/blocks/new?date=<%= stpim.util.Clock.today() %>&compareBlockId=<%= records.isEmpty()?active.getId():records.get(records.size()-1).getId() %>">今日に追加</a></div>
<div class="metric-grid"><div class="metric-card"><span class="metric-label">自己ベスト</span><span class="metric-value"><%= best==null?"—":best+"分" %></span></div><div class="metric-card"><span class="metric-label">直近の記録</span><span class="metric-value"><%= records.isEmpty()?"—":TimeAttackServlet.durationMinutes(records.get(records.size()-1))+"分" %></span></div><div class="metric-card"><span class="metric-label">記録数</span><span class="metric-value"><%= records.size() %></span></div></div>
<p class="chart-title">所要時間の推移（分）</p><div class="chart"><% if(records.isEmpty()){ %><div class="no-data" style="width:100%">記録がありません</div><% } else { int max=1; for(Block b:records) max=Math.max(max,TimeAttackServlet.durationMinutes(b)); for(int i=0;i<records.size();i++){Block b=records.get(i);int mins=TimeAttackServlet.durationMinutes(b); %><div class="chart-column"><span class="chart-number"><%= mins %></span><div class="chart-bar <%= i==records.size()-1?"latest":"" %>" style="height:<%= Math.max(12,mins*125/max) %>px"></div><span class="chart-label"><%= b.getActualEndAt().toLocalDate().getMonthValue() %>/<%= b.getActualEndAt().getDayOfMonth() %></span></div><% } } %></div><div class="soft-note records-footnote">優先順位ブロックは、開始ボタンを押して所要時間を記録した場合だけ表示されます。</div></section></div><% } %></main></div></body></html>
