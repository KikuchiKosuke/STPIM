<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.time.LocalDate,java.time.YearMonth,java.time.DayOfWeek,java.util.List,stpim.model.Block,stpim.model.BlockStatus,stpim.model.BlockType,stpim.util.Html" %>
<%
YearMonth month = (YearMonth) request.getAttribute("month");
LocalDate selectedDate = (LocalDate) request.getAttribute("selectedDate");
@SuppressWarnings("unchecked") List<Block> blocks = (List<Block>) request.getAttribute("blocks");
String ctx = request.getContextPath();
LocalDate gridStart = month.atDay(1).minusDays(month.atDay(1).getDayOfWeek().getValue() % 7);
String[] weekdays = {"日","月","火","水","木","金","土"};
%>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>カレンダー | STPIM</title><link rel="stylesheet" href="<%= ctx %>/css/style.css"></head><body><div class="app-shell">
<%@ include file="header.jspf" %>
<main class="page"><div class="page-heading"><div><p class="eyebrow">予定を見渡す</p><h1>カレンダー</h1><p class="heading-sub">積み上げた予定を、今日の流れに。</p></div><div class="heading-actions"><a class="button" href="<%= ctx %>/calendar">今日に戻る</a><a class="button primary" href="<%= ctx %>/blocks/new?date=<%= selectedDate %>">＋ ブロックを追加</a></div></div>
<div class="calendar-layout"><section class="panel calendar-panel"><div class="calendar-toolbar"><a class="button icon" aria-label="前月" href="?month=<%= month.minusMonths(1) %>&date=<%= selectedDate %>">‹</a><h2 class="month-title"><span class="mono"><%= month.getYear() %></span>年<%= month.getMonthValue() %>月</h2><a class="button icon" aria-label="次月" href="?month=<%= month.plusMonths(1) %>&date=<%= selectedDate %>">›</a><span class="spacer"></span><a class="button small" href="<%= ctx %>/calendar">今日</a></div>
<div class="weekday-row"><% for (int i=0;i<weekdays.length;i++) { %><div class="weekday" style="<%= i==0 ? "color:#bb7868" : i==6 ? "color:#6d91aa" : "" %>"><%= weekdays[i] %></div><% } %></div>
<div class="calendar-grid"><% for (int i=0;i<42;i++) { LocalDate day=gridStart.plusDays(i); int count=0,done=0,missed=0; for(Block b:blocks) if(b.getTargetDate().equals(day)){ count++; if(b.getStatus()==BlockStatus.DONE)done++; if(b.getStatus()==BlockStatus.MISSED)missed++; } %>
<a class="day-cell <%= day.getMonthValue()!=month.getMonthValue() ? "muted" : "" %> <%= day.equals(selectedDate) ? "selected" : "" %> <%= day.equals(LocalDate.now(stpim.util.Clock.ZONE)) ? "today" : "" %>" href="?month=<%= month %>&date=<%= day %>" aria-label="<%= day %>、<%= count %>件">
<span class="day-num"><%= day.getDayOfMonth() %></span><span class="day-bars"><% int shown=0; for(Block b:blocks) if(b.getTargetDate().equals(day) && shown++<4){ %><span class="day-bar <%= b.getBlockType()==BlockType.PRIORITY ? "priority" : "" %> <%= b.isTimeAttack() ? "attack" : "" %> <%= b.getStatus()==BlockStatus.MISSED ? "missed" : "" %>"></span><% } %></span><span class="day-meta"><%= missed>0 ? "未処理 " + missed : count>0 ? done==count ? "全クリア" : count + "件" : "" %></span></a>
<% } %></div></section>
<aside class="calendar-side"><section class="panel side-card"><p class="eyebrow">選択した日</p><div class="selected-date"><%= selectedDate.getMonthValue() %>月<%= selectedDate.getDayOfMonth() %>日（<%= weekdays[selectedDate.getDayOfWeek().getValue()%7] %>）</div><div class="mini-list"><% int shown=0; for(Block b:blocks) if(b.getTargetDate().equals(selectedDate) && shown++<5){ %><a class="mini-item <%= b.getBlockType()==BlockType.PRIORITY ? "priority" : "" %> <%= b.isTimeAttack() ? "attack" : "" %>" href="<%= ctx %>/day?date=<%= selectedDate %>&tab=<%= b.getBlockType() %>"><span class="mini-time"><%= b.getBlockType()==BlockType.TIME ? b.getPlannedStartTime() : "優先 " + b.getPriority().getLabel() %></span><span class="mini-item-title"><%= Html.escape(b.getTitle()) %></span></a><% } if(shown==0){ %><div class="empty-mini">この日のブロックはありません</div><% } %></div><a class="button primary" style="width:100%" href="<%= ctx %>/day?date=<%= selectedDate %>">この日のブロックを見る　→</a></section>
<section class="panel side-card legend-panel"><h2>凡例</h2><div class="legend"><span class="legend-item"><i class="legend-dot"></i>時間制</span><span class="legend-item"><i class="legend-dot priority"></i>優先順位</span><span class="legend-item"><i class="legend-dot attack"></i>タイムアタック</span></div><div class="divider"></div><p class="tiny" style="line-height:1.7;margin:0">終了予定を過ぎた時間制ブロックは未処理として残ります。</p></section></aside></div></main></div></body></html>
